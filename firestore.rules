rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email == "printingideas060@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /printingIdeas/{documentId} {
      allow read, write: if isAllowedUser()
        && (documentId == "shared" || request.auth.uid == documentId);

      match /sales/{saleId} {
        allow read, write: if documentId == "shared" && isAllowedUser();
      }
    }
  }
}
